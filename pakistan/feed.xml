---
layout: null
permalink: /pakistan/feed.xml
sitemap: false
---
<?xml version="1.0" encoding="utf-8"?>
{%- assign notes = site.pakistan_notes | sort: "date" | reverse %}
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>Pakistan Vitals weekly notes</title>
  <subtitle>What changed in Pakistan's economy this week, and what to watch next.</subtitle>
  <link href="{{ '/pakistan/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ '/pakistan/' | absolute_url }}" rel="alternate" type="text/html"/>
  <id>{{ '/pakistan/feed.xml' | absolute_url }}</id>
  <updated>{% if notes.first %}{{ notes.first.date | date_to_xmlschema }}{% else %}{{ site.time | date_to_xmlschema }}{% endif %}</updated>
  <author><name>{{ site.author | xml_escape }}</name></author>
  {%- for note in notes limit: 20 %}
  <entry>
    <title type="html">{{ note.title | xml_escape }}</title>
    <link href="{{ note.url | absolute_url }}" rel="alternate" type="text/html"/>
    <id>{{ note.url | absolute_url }}</id>
    <published>{{ note.date | date_to_xmlschema }}</published>
    <updated>{{ note.date | date_to_xmlschema }}</updated>
    {%- if note.subtitle %}
    <summary type="html">{{ note.subtitle | xml_escape }}</summary>
    {%- endif %}
    <content type="html" xml:base="{{ note.url | absolute_url }}">{{ note.content | xml_escape }}</content>
  </entry>
  {%- endfor %}
</feed>
